generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssetCondition {
  GOOD
  UNDER_MAINTENANCE
  SCRAPPED
  RESERVED
}

enum TransferStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  TRANSFERRED
  REJECTED
  CANCELLED
}

enum AuditStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AssetSubCategory {
  EXECUTIVE_DESK
  HYDRAULIC_CHAIR
  VISITOR_SEATING
  FILING_CABINET
  MAIL_SORTING_TABLE
  SERVICE_COUNTER
  HEAVY_SAFE
  DESKTOP_PC
  LAPTOP_DOCK
  POSTAL_SCALE
  BARCODE_SCANNER
  THERMAL_PRINTER
  POS_TERMINAL
  UPS_UNIT
  QUEUE_SCREEN
  SPLIT_AC
  FIRE_EXTINGUISHER
  WATER_COOLER
  COFFEE_MACHINE
}

model Employees {
  id            String   @id @default(cuid())
  fullName      String
  employeeNumber String  @unique
  role          String
  department    String
  avatarUrl     String?
  email         String?
  phone         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  offices       Offices[]
  assets        Assets[]
  transferFrom  AssetTransfers[] @relation("TransferFromEmployee")
  transferTo    AssetTransfers[] @relation("TransferToEmployee")

  @@map("employees")
}

model Offices {
  id            String   @id @default(cuid())
  officeCode    String   @unique
  officeName    String
  branch        String
  floor         String?
  building      String?
  city          String   @default("Amman")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employeeId    String?
  employee      Employees? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  assets        Assets[]
  audits        InventoryAudits[]

  @@map("offices")
}

model AssetCategories {
  id          String   @id @default(cuid())
  name        String   @unique
  nameAr      String
  description String?
  icon        String?
  createdAt   DateTime @default(now())

  assets      Assets[]

  @@map("asset_categories")
}

model Assets {
  id              String         @id @default(cuid())
  serialNumber    String         @unique
  assetTag        String         @unique
  qrCode          String         @unique
  itemName        String
  itemNameAr      String
  specifications  Json?
  condition       AssetCondition @default(GOOD)
  acquisitionDate DateTime       @default(now())
  warrantyExpiry  DateTime?
  purchasePrice   Decimal?       @db.Decimal(12, 2)
  currentValue    Decimal?       @db.Decimal(12, 2)
  subCategory     AssetSubCategory
  notes           String?
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  officeId        String
  office          Offices        @relation(fields: [officeId], references: [id], onDelete: Restrict)

  categoryId      String
  category        AssetCategories @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  employeeId      String?
  employee        Employees?     @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  auditItems      AuditItems[]
  transferAssets  TransferAssets[]

  @@map("assets")
}

model InventoryAudits {
  id            String      @id @default(cuid())
  sessionCode   String      @unique
  title         String
  status        AuditStatus @default(SCHEDULED)
  scheduledDate DateTime
  startedAt     DateTime?
  completedAt   DateTime?
  notes         String?
  varianceCount Int         @default(0)
  totalItems    Int         @default(0)
  createdBy     String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  officeId      String
  office        Offices     @relation(fields: [officeId], references: [id], onDelete: Restrict)

  items         AuditItems[]

  @@map("inventory_audits")
}

model AuditItems {
  id              String  @id @default(cuid())
  expectedQty     Int     @default(1)
  countedQty      Int     @default(0)
  variance        Int     @default(0)
  condition       AssetCondition?
  notes           String?
  isVerified      Boolean @default(false)

  auditId         String
  audit           InventoryAudits @relation(fields: [auditId], references: [id], onDelete: Cascade)

  assetId         String
  asset           Assets         @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([auditId, assetId])
  @@map("audit_items")
}

model AssetTransfers {
  id              String         @id @default(cuid())
  transferCode    String         @unique
  status          TransferStatus @default(DRAFT)
  requestDate     DateTime       @default(now())
  approvedDate    DateTime?
  completedDate   DateTime?
  reason          String
  notes           String?
  approvedBy      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  fromOfficeId    String
  fromOffice      Offices       @relation("FromOffice", fields: [fromOfficeId], references: [id], onDelete: Restrict)

  toOfficeId      String
  toOffice        Offices       @relation("ToOffice", fields: [toOfficeId], references: [id], onDelete: Restrict)

  fromEmployeeId  String?
  fromEmployee    Employees?    @relation("TransferFromEmployee", fields: [fromEmployeeId], references: [id], onDelete: SetNull)

  toEmployeeId    String?
  toEmployee      Employees?    @relation("TransferToEmployee", fields: [toEmployeeId], references: [id], onDelete: SetNull)

  assets          TransferAssets[]

  @@map("asset_transfers")
}

model TransferAssets {
  id          String  @id @default(cuid())
  condition   AssetCondition @default(GOOD)
  notes       String?

  transferId  String
  transfer    AssetTransfers @relation(fields: [transferId], references: [id], onDelete: Cascade)

  assetId     String
  asset       Assets        @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([transferId, assetId])
  @@map("transfer_assets")
}
